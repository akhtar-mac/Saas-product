# Copy to apps/api/.env on the tenant VPS. Never commit real values.
PORT=5001
NODE_ENV=production
DATABASE_URL=mysql://crm:change-me@127.0.0.1:3306/crm
JWT_SECRET=replace-with-a-long-random-string
ENCRYPTION_KEY=replace-with-another-long-random-string
FRONTEND_URL=https://crm.example.com
CORS_ORIGINS=https://crm.example.com,https://www.example.com
CUSTOM_DOMAIN=crm.example.com
COMPANY_CODE=TENANT
COMPANY_NAME=Your Company
COMPANY_LEGAL_NAME=Your Company
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=
LEAD_EMAIL_DOMAIN=example.com
QUOTE_PREFIX=QT
# Leave payment and messaging secrets empty here.
# Store them in Admin → Workspace settings. They are encrypted and never returned in full.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
