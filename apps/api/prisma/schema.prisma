generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Staff user accounts — authentication table for all 16 roles
model staff_users {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  password_hash String    @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  role_id       Int
  roles         String?
  permissions   String?
  profile_photo String?   @db.VarChar(500)
  position      String?   @db.VarChar(100)
  department    String?   @db.VarChar(100)
  is_active     Boolean   @default(true)
  is_online     Boolean   @default(false)
  last_login_at DateTime?
  last_seen_at  DateTime?
  created_by    Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model staff_user_roles {
  id          Int      @id @default(autoincrement())
  user_id     Int
  role_id     Int
  assigned_by Int?
  assigned_at DateTime @default(now())

  @@unique([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
}

model audit_logs {
  id          Int      @id @default(autoincrement())
  actor_id    Int?
  actor_email String?  @db.VarChar(150)
  actor_role  String?  @db.VarChar(50)
  action      String   @db.VarChar(100)
  resource    String   @db.VarChar(100)
  resource_id String?  @db.VarChar(50)
  payload     String?  @db.Text
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  @@index([actor_id])
  @@index([action])
  @@index([resource])
  @@index([created_at])
}

model job_applications {
  id                 Int                   @id @default(autoincrement())
  job_id             Int?
  first_name         String                @db.VarChar(100)
  last_name          String?               @db.VarChar(100)
  email              String                @db.VarChar(150)
  phone              String                @db.VarChar(30)
  role_applied       String                @db.VarChar(150)
  department         String?               @default("General") @db.VarChar(100)
  current_company    String?               @db.VarChar(150)
  current_title      String?               @db.VarChar(150)
  experience_years   String?               @db.VarChar(50)
  expected_ctc       String?               @db.VarChar(50)
  notice_period_days String?               @db.VarChar(50)
  linkedin_url       String?               @db.VarChar(500)
  portfolio_url      String?               @db.VarChar(500)
  source             String?               @default("Careers Page") @db.VarChar(100)
  status             String                @default("APPLIED") @db.VarChar(50)
  rating             Int?                  @default(0) @db.SmallInt
  created_at         DateTime              @default(now()) @db.Timestamp(6)
  updated_at         DateTime              @default(now()) @db.Timestamp(6)
  events             application_events[]
  notes              application_notes[]
  documents          candidate_documents[]
  interviews         interviews[]
  offers             job_offers[]

  @@index([status])
  @@index([email])
  @@index([created_at])
}

model candidate_documents {
  id             Int              @id @default(autoincrement())
  application_id Int
  document_type  String           @default("RESUME") @db.VarChar(50)
  file_name      String           @db.VarChar(255)
  file_key       String           @db.VarChar(500)
  file_size      Int?
  mime_type      String?          @db.VarChar(100)
  uploaded_at    DateTime         @default(now()) @db.Timestamp(6)
  application    job_applications @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
}

model application_notes {
  id             Int              @id @default(autoincrement())
  application_id Int
  author_id      Int?
  author_name    String?          @db.VarChar(150)
  note_content   String           @db.Text
  is_private     Boolean          @default(false)
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  application    job_applications @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
}

model interviews {
  id               Int                  @id @default(autoincrement())
  application_id   Int
  round_number     Int                  @default(1) @db.SmallInt
  round_name       String               @default("Technical Round") @db.VarChar(100)
  interview_type   String               @default("GOOGLE_MEET") @db.VarChar(50)
  scheduled_at     DateTime             @default(now()) @db.Timestamp(6)
  duration_minutes Int                  @default(45)
  meeting_link     String?              @db.VarChar(500)
  interviewer_id   Int?
  interviewer_name String?              @db.VarChar(150)
  status           String               @default("SCHEDULED") @db.VarChar(50)
  created_at       DateTime             @default(now()) @db.Timestamp(6)
  feedback         interview_feedback[]
  application      job_applications     @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
}

model interview_feedback {
  id               Int        @id @default(autoincrement())
  interview_id     Int
  interviewer_id   Int?
  interviewer_name String?    @db.VarChar(150)
  score            Int        @default(3) @db.SmallInt
  strengths        String?    @db.Text
  weaknesses       String?    @db.Text
  recommendation   String     @default("HIRE") @db.VarChar(50)
  notes            String?    @db.Text
  submitted_at     DateTime   @default(now()) @db.Timestamp(6)
  interview        interviews @relation(fields: [interview_id], references: [id], onDelete: Cascade)

  @@index([interview_id], map: "interview_feedback_interview_id_fkey")
}

model job_offers {
  id               Int              @id @default(autoincrement())
  application_id   Int
  offered_ctc      String           @db.VarChar(50)
  designation      String           @db.VarChar(150)
  joining_date     DateTime?        @db.Date
  offer_letter_key String?          @db.VarChar(500)
  status           String           @default("DRAFT") @db.VarChar(50)
  approved_by      Int?
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  application      job_applications @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id], map: "job_offers_application_id_fkey")
}

model application_events {
  id             Int              @id @default(autoincrement())
  application_id Int
  actor_id       Int?
  actor_name     String?          @db.VarChar(150)
  from_status    String?          @db.VarChar(50)
  to_status      String           @db.VarChar(50)
  reason         String?          @db.Text
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  application    job_applications @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
}

model chat_conversations {
  id              Int       @id @default(autoincrement())
  type            String    @default("direct") @db.VarChar(20)
  title           String?   @db.VarChar(150)
  created_by      Int?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt
  last_message_at DateTime?
}

model chat_members {
  id              Int       @id @default(autoincrement())
  conversation_id Int
  user_id         Int
  role            String    @default("member") @db.VarChar(20)
  last_read_at    DateTime?
  joined_at       DateTime  @default(now())

  @@unique([conversation_id, user_id])
  @@index([user_id])
  @@index([conversation_id])
}

model chat_messages {
  id              Int      @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  content         String   @db.Text
  message_type    String   @default("text") @db.VarChar(20)
  created_at      DateTime @default(now())

  @@index([conversation_id, created_at])
  @@index([sender_id])
}

model chat_attachments {
  id          Int      @id @default(autoincrement())
  message_id  Int
  file_name   String   @db.VarChar(255)
  file_path   String   @db.VarChar(500)
  file_size   Int
  mime_type   String   @db.VarChar(100)
  uploaded_at DateTime @default(now())

  @@index([message_id])
}

model user_presence {
  id           Int      @id @default(autoincrement())
  user_id      Int      @unique
  status       String   @default("offline") @db.VarChar(20)
  socket_id    String?  @db.VarChar(100)
  last_seen_at DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@index([user_id])
}

/// Android call log entries synced from Flutter sales app
model call_logs {
  id               Int      @id @default(autoincrement())
  user_id          Int
  lead_id          Int?
  phone_number     String   @db.VarChar(20)
  direction        String   @db.VarChar(20)
  status           String   @db.VarChar(20)
  duration_seconds Int      @default(0)
  called_at        DateTime
  synced_at        DateTime @default(now())
  device_call_id   String?  @db.VarChar(100)
  created_at       DateTime @default(now())

  @@unique([user_id, device_call_id])
  @@index([user_id, called_at])
  @@index([lead_id])
}

/// Orders created from the Won Conversion Form (v2 CRM — not the legacy orders table)
model crm_orders {
  id                     Int       @id @default(autoincrement())
  customer_id            Int
  lead_id                Int
  category_id            Int
  service_id             Int
  total_amount           Decimal   @db.Decimal(10, 2)
  coupon_code            String?   @db.VarChar(50)
  discount_amount        Decimal   @default(0.00) @db.Decimal(10, 2)
  paid_amount            Decimal   @db.Decimal(10, 2)
  unpaid_amount          Decimal   @db.Decimal(10, 2)
  payment_mode           String    @db.VarChar(50)
  next_due_date          DateTime? @db.Date
  comment                String?
  payment_screenshot_url String?   @db.VarChar(500)
  sales_employee_id      Int
  payment_status         String    @default("advance_paid")
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@index([customer_id])
  @@index([lead_id])
}

model ads {
  id            Int      @id @default(autoincrement())
  ads_category  Int
  ads_link      String?  @db.VarChar(250)
  ads_thumbnail String   @db.VarChar(250)
  is_active     Int      @default(0) @db.SmallInt
  date          DateTime @default(now()) @db.Timestamp(6)
}

model affiliates {
  id            Decimal   @id @db.Decimal(20, 0)
  name          String    @db.VarChar(255)
  email         String    @db.VarChar(255)
  mobile        String    @db.VarChar(255)
  password      String    @db.VarChar(255)
  referral_code String    @db.VarChar(255)
  is_active     Int       @default(0)
  created_at    DateTime? @db.Timestamp(6)
  updated_at    DateTime? @db.Timestamp(6)
}

model appointments {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(50)
  email          String   @db.VarChar(50)
  mobile         String   @db.VarChar(20)
  city           String   @db.VarChar(50)
  message        String   @db.VarChar(500)
  order_id       String?  @db.VarChar(150)
  payment_id     String?  @db.VarChar(150)
  amount         Int?
  is_complete    Int      @default(0)
  payment_status Int      @default(0)
  ap_date        String?  @db.VarChar(15)
  ap_time        String?  @db.VarChar(15)
  ap_mode        String?  @db.VarChar(25)
  is_online      Int      @default(0)
  conduct_by     String?  @db.VarChar(30)
  added_by       String   @db.VarChar(50)
  is_delete      Int      @default(0)
  date           DateTime @default(now()) @db.Date
}

model blocked_websites {
  id          Decimal   @id @db.Decimal(20, 0)
  user_id     Int
  website_url String    @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model blogs {
  id               Int       @id @default(autoincrement())
  title            String    @db.VarChar(250)
  meta_title       String?   @db.VarChar(500)
  meta_description String?
  meta_keywords    String?
  focus_keyword    String?   @db.VarChar(500)
  slug             String    @db.VarChar(250)
  old_slug         String?   @db.VarChar(500)
  category         String    @db.VarChar(100)
  thumbnail        String    @db.VarChar(500)
  thumbnail_alt    String?   @db.VarChar(255)
  content          String?
  faq_schema       String?
  canonical_url    String?   @db.VarChar(500)
  is_active        Int       @default(0)
  date             DateTime  @default(now()) @db.Timestamp(6)
  created_at       DateTime? @db.Timestamp(6)
  updated_at       DateTime? @db.Timestamp(6)
}

model ca_onboards {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255)
  email          String   @db.VarChar(255)
  contact        String   @db.VarChar(25)
  city           String   @db.VarChar(255)
  profession     String   @db.VarChar(255)
  order_id       String?  @db.VarChar(255)
  payment_id     String?  @db.VarChar(255)
  signature      String?  @db.VarChar(255)
  total_amount   Int
  payment_status Int      @default(0)
  payment_link   String?  @db.VarChar(255)
  date           DateTime @default(now()) @db.Timestamp(6)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @default(now()) @db.Timestamp(6)
}

model call_history {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  lead_id        Int
  user_id        BigInt    @db.UnsignedBigInt
  contact        String    @db.VarChar(20)
  lead_source    String?   @db.VarChar(50)
  name           String?   @db.VarChar(255)
  call_type      String    @db.VarChar(20)
  duration       Int?
  call_timestamp DateTime  @default(now()) @db.Timestamp(0)
  call_date      DateTime  @db.Date
  created_at     DateTime? @default(now()) @db.Timestamp(0)
  updated_at     DateTime? @default(now()) @db.Timestamp(0)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model call_remarks {
  call_id              Int @id
  lead_id              Int
  lead_status          Int
  user_id              Int
  call_status          Int
  call_remark          String    @db.VarChar(250)
  call_followup_date   DateTime? @db.Date
  call_followup_remark String?   @db.VarChar(250)
  call_date            DateTime  @default(now()) @db.Date

}

model campaign_leads {
  id          Int       @id @default(autoincrement())
  campaign_id Int
  lead_id     Int
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model campaigns {
  id            Int       @id @default(autoincrement())
  campaign_name String    @db.VarChar(255)
  platform      String
  budget        Decimal?  @default(0.00) @db.Decimal(12, 2)
  spent_amount  Decimal?  @default(0.00) @db.Decimal(12, 2)
  start_date    DateTime? @db.Date
  end_date      DateTime? @db.Date
  status        String?   @default("draft")
  landing_url   String?
  utm_source    String?   @db.VarChar(100)
  utm_medium    String?   @db.VarChar(100)
  utm_campaign  String?   @db.VarChar(100)
  total_leads   Int?      @default(0)
  created_by    Int?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model cart {
  cart_id       Int      @id @default(autoincrement())
  cust_id       Int
  cat_id        Int
  service_id    Int
  service_price String   @db.VarChar(11)
  is_buy        Int      @default(0) @db.SmallInt
  date          DateTime @default(now()) @db.Timestamp(6)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model categories {
  category_id   Int @id
  company_id    String @db.VarChar(11)
  category_name String @db.VarChar(100)
  added_by      Int
  date          String @db.VarChar(50)

}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model combo_packages {
  cp_id       Int       @id @default(autoincrement())
  service_id  String    @db.VarChar(255)
  cp_title    Int
  cp_type     Int
  cp_discount Int
  company_id  String    @db.VarChar(20)
  added_by    Int
  cp_date     DateTime? @default(now()) @db.DateTime(0)

}

model comments {
  id         Decimal   @id @db.Decimal(20, 0)
  blog_id    Decimal   @db.Decimal(20, 0)
  user_id    Decimal?  @db.Decimal(20, 0)
  name       String?   @db.VarChar(255)
  email      String?   @db.VarChar(255)
  mobile     String    @db.VarChar(20)
  parent_id  Decimal?  @db.Decimal(20, 0)
  comment    String
  approved   Int       @default(0) @db.SmallInt
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
}

model contact_us {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  number     String    @db.VarChar(15)
  email      String    @db.VarChar(100)
  city       String?   @db.VarChar(100)
  state      String?   @db.VarChar(100)
  subject    String?   @db.VarChar(200)
  message    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model contacts {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  email      String    @db.VarChar(150)
  phone      String    @db.VarChar(20)
  city       String    @db.VarChar(100)
  state      String    @db.VarChar(100)
  subject    String    @db.VarChar(200)
  message    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model core_services {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(100)
  image   String? @db.VarChar(500)
  content String  @db.VarChar(500)
}

model coupons {
  coupon_id        Int      @id @default(autoincrement())
  coupon_type      Int
  coupon_name      String   @db.VarChar(30)
  coupon_discount  Int
  coupon_validity  String   @db.VarChar(15)
  coupon_uses      Int
  coupon_remaining Int
  is_active        Int      @default(0)
  date             DateTime @default(now()) @db.Timestamp(6)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model custom_packages {
  id           Int
  service_ids  String   @db.VarChar(100)
  cp_id        Int
  customer_id  Int
  price        Int
  package_name String   @db.VarChar(100)
  added_by     Int
  date         DateTime @default(now()) @db.Timestamp(0)

  @@ignore
}

model customer_affiliate_referrals {
  id           Decimal   @id @db.Decimal(20, 0)
  affiliate_id Decimal   @db.Decimal(20, 0)
  customer_id  Int
  created_at   DateTime? @db.Timestamp(6)
  updated_at   DateTime? @db.Timestamp(6)
}

model customer_chatting {
  chat_id    Int      @id @default(autoincrement())
  service_id Int
  chat_from  Int
  chat_to    Int
  chat_msg   String?  @db.VarChar(1000)
  date       DateTime @default(now()) @db.Timestamp(6)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model customer_documents {
  cd_id      Int @id
  service_id Int?
  cd_from    String   @db.VarChar(10)
  cd_to      Int
  cd_name    String   @db.VarChar(100)
  cd_doc     String   @db.VarChar(100)
  date       DateTime @default(now()) @db.DateTime(0)

}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model customer_dues {
  cd_id              Int
  emi_id             Int
  customer_id        Int
  paid_amount        Int
  unpaid_amount      Int
  payment_screenshot String   @db.VarChar(250)
  added_by           Int
  is_approve         Int      @default(0)
  date               DateTime @default(now()) @db.Timestamp(0)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model customer_emi {
  emi_id              Int       @id @default(autoincrement())
  customer_id         Int
  order_id            Int
  emi_type            Int
  emi_total_amount    Int
  emi_paid_amount     Int
  emi_unpaid_amount   Int
  emi_due_date        DateTime? @db.Date
  second_emi          Int?
  second_emi_due_date DateTime? @db.Date
  emi_comment         String    @db.VarChar(2400)
  payment_screenshot  String?   @db.VarChar(250)
  date                DateTime  @default(now()) @db.Timestamp(0)

}

model customer_inquiries {
  inq_id       Int      @id @default(autoincrement())
  cust_id      Int
  service_id   Int
  cust_query   String   @db.VarChar(250)
  inquiry_from Int      @default(1)
  inq_date     DateTime @default(now()) @db.Timestamp(6)
}

model customer_notifications {
  id         Int       @id @default(autoincrement())
  cust_id    Int
  title      String?   @db.VarChar(255)
  message    String?
  is_read    Int?      @default(0) @db.SmallInt
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model customer_payment_links {
  link_id     Int     @id @default(autoincrement())
  emi_id      Int
  customer_id Int
  package_id  Int
  link_url    String  @db.VarChar(250)
  order_id    String? @db.VarChar(250)
  payment_id  String? @db.VarChar(250)
  amount      Int?
  is_payment  Int     @default(0)
}

model customer_tickets {
  ticket_id     Int      @id @default(autoincrement())
  customer_id   Int
  service_id    Int
  ticket_msg    String   @db.VarChar(250)
  ticket_answer String?  @db.VarChar(250)
  is_open       Int      @default(0)
  date          DateTime @default(now()) @db.Timestamp(6)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model customer_work_timeline {
  id            Int @id
  cust_id       Int
  service_id    Int
  task_id       Int
  work          String    @db.VarChar(500)
  work_hour     Int?
  work_minute   Int?
  work_seconds  Int       @default(0)
  is_running    Boolean?  @default(false)
  running_start DateTime? @db.DateTime(0)
  status        Int
  added_by      Int
  date          String    @db.VarChar(20)
  time          String    @db.VarChar(20)
  start_time    DateTime? @db.Time(0)
  end_time      DateTime? @db.Time(0)

}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model customers {
  id             Int      @id @default(autoincrement())
  lead_id        Int
  name           String   @db.VarChar(100)
  business       String   @db.VarChar(100)
  email          String   @db.VarChar(100)
  contact        String   @db.VarChar(20)
  password       String   @db.VarChar(255)
  service        String   @db.VarChar(120)
  service_price  Int
  state          String   @db.VarChar(100)
  city           String   @db.VarChar(100)
  added_by       Int
  company_id     String   @db.VarChar(11)
  is_payment     Int      @default(0) @db.TinyInt
  is_active      Int      @default(1)
  is_approve     Int      @default(0)
  is_partner     Int      @default(1)
  customer_token String   @db.VarChar(500)
  date           DateTime @default(now()) @db.Timestamp(0)

}

model desktop_users {
  id              Int    @id @default(autoincrement())
  username        String @db.VarChar(100)
  user_id         Int
  idle_time       Int
  screenshot_time Int
}

/// Desktrack "Manage IPs" (old DesktopController::manageIP). The table exists on live;
/// the API still checks information_schema before touching it.
model ips {
