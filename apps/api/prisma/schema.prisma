generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NEW MODELS for ETaxwala 2.0 CRM ─────────────────────────────────────────

/// Staff user accounts — authentication table for all 15 roles
model staff_users {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(150)
  password_hash   String    @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  role_id         Int       // 1=super_admin … 15=website_manager
  permissions     String?   // JSON array of permission keys (e.g. ["dashboard:view", "sales:view"])
  profile_photo   String?   @db.VarChar(500)
  position        String?   @db.VarChar(100)
  is_active       Boolean   @default(true)
  last_login_at   DateTime?
  created_by      Int?      // user_id of admin who created this account
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

/// Android call log entries synced from Flutter sales app
model call_logs {
  id               Int      @id @default(autoincrement())
  user_id          Int      // staff_users.id
  lead_id          Int?     // matched lead (nullable if number not in system)
  phone_number     String   @db.VarChar(20)
  direction        String   @db.VarChar(20)  // "outgoing" | "incoming"
  status           String   @db.VarChar(20)  // "answered" | "missed" | "rejected"
  duration_seconds Int      @default(0)
  called_at        DateTime
  synced_at        DateTime @default(now())
  device_call_id   String?  @db.VarChar(100) // native Android call log ID for dedup
  created_at       DateTime @default(now())

  @@unique([user_id, device_call_id]) // prevent duplicate syncs
  @@index([user_id, called_at])
  @@index([lead_id])
}

/// Orders created from the Won Conversion Form (v2 CRM — not the legacy orders table)
model crm_orders {
  id                     Int      @id @default(autoincrement())
  customer_id            Int
  lead_id                Int
  category_id            Int
  service_id             Int
  total_amount           Decimal  @db.Decimal(10, 2)
  coupon_code            String?  @db.VarChar(50)
  discount_amount        Decimal  @default(0) @db.Decimal(10, 2)
  paid_amount            Decimal  @db.Decimal(10, 2)
  unpaid_amount          Decimal  @db.Decimal(10, 2)
  payment_mode           String   @db.VarChar(50)
  next_due_date          DateTime? @db.Date
  comment                String?
  payment_screenshot_url String?  @db.VarChar(500)
  sales_employee_id      Int
  payment_status         String   @default("advance_paid") // advance_paid | fully_paid
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@index([customer_id])
  @@index([lead_id])
}


