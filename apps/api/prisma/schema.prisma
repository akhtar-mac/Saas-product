  objective        String?                        @default("LEAD_GENERATION") @db.VarChar(100)
  daily_budget     Decimal                        @default(0.00) @db.Decimal(12, 2)
  total_spent      Decimal                        @default(0.00) @db.Decimal(12, 2)
  impressions      Int                            @default(0)
  clicks           Int                            @default(0)
  leads_generated  Int                            @default(0)
  conversions      Int                            @default(0)
  cpl              Decimal                        @default(0.00) @db.Decimal(10, 2)
  roas             Decimal                        @default(0.00) @db.Decimal(6, 2)
  status           String                         @default("ACTIVE") @db.VarChar(50)
  start_date       DateTime?                      @db.Date
  end_date         DateTime?                      @db.Date
  target_audience  String?
  landing_page_url String?                        @db.VarChar(500)
  created_at       DateTime                       @default(now()) @db.Timestamp(6)
  updated_at       DateTime                       @default(now()) @db.Timestamp(6)
  snapshots        ad_metrics_snapshots[]
  attributions     marketing_attribution_events[]

  @@index([platform])
  @@index([status])
}

model ad_metrics_snapshots {
  id            Int          @id @default(autoincrement())
  campaign_id   Int
  snapshot_date DateTime     @db.Date
  spend_amount  Decimal      @default(0.00) @db.Decimal(12, 2)
  impressions   Int          @default(0)
  clicks        Int          @default(0)
  leads_count   Int          @default(0)
  cpl           Decimal      @default(0.00) @db.Decimal(10, 2)
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  campaign      ad_campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([snapshot_date])
  @@index([campaign_id], map: "ad_metrics_snapshots_campaign_id_fkey")
}

model marketing_attribution_events {
  id                  Int           @id @default(autoincrement())
  lead_id             BigInt?
  campaign_id         Int?
  utm_source          String?       @db.VarChar(100)
  utm_medium          String?       @db.VarChar(100)
  utm_campaign        String?       @db.VarChar(150)
  utm_term            String?       @db.VarChar(150)
  utm_content         String?       @db.VarChar(150)
  referrer_url        String?       @db.VarChar(500)
  landing_page        String?       @db.VarChar(500)
  ip_address          String?       @db.VarChar(45)
  device_type         String?       @db.VarChar(50)
  touchpoint_sequence Int?          @default(1) @db.SmallInt
  converted_to_order  Boolean       @default(false)
  attributed_revenue  Decimal?      @default(0.00) @db.Decimal(12, 2)
  created_at          DateTime      @default(now()) @db.Timestamp(6)
  campaign            ad_campaigns? @relation(fields: [campaign_id], references: [id])

  @@index([lead_id])
  @@index([utm_source])
  @@index([campaign_id], map: "marketing_attribution_events_campaign_id_fkey")
}

model integration_credentials {
  id                       Int                     @id @default(autoincrement())
  provider                 String                  @db.VarChar(50)
  account_id               String                  @db.VarChar(150)
  account_name             String                  @db.VarChar(150)
  encrypted_access_token   String
  encrypted_refresh_token  String?
  token_iv                 String                  @db.VarChar(64)
  token_auth_tag           String                  @db.VarChar(64)
  webhook_secret_encrypted String?
  webhook_secret_iv        String?                 @db.VarChar(64)
  webhook_secret_tag       String?                 @db.VarChar(64)
  status                   String                  @default("ACTIVE") @db.VarChar(50)
  token_expiry             DateTime?               @db.Timestamp(6)
  last_synced_at           DateTime?               @db.Timestamp(6)
  created_at               DateTime                @default(now()) @db.Timestamp(6)
  updated_at               DateTime                @default(now()) @db.Timestamp(6)
  sync_jobs                integration_sync_jobs[]

  @@index([provider])
  @@index([status])
}

model integration_sync_jobs {
  id              Int                     @id @default(autoincrement())
  job_code        String                  @unique @db.VarChar(50)
  integration_id  Int
  job_type        String                  @default("DAILY_METRICS_SYNC") @db.VarChar(50)
  status          String                  @default("RUNNING") @db.VarChar(50)
  records_synced  Int                     @default(0)
  summary_payload String?
  error_message   String?
  started_at      DateTime                @default(now()) @db.Timestamp(6)
  completed_at    DateTime?               @db.Timestamp(6)
  integration     integration_credentials @relation(fields: [integration_id], references: [id], onDelete: Cascade)

  @@index([integration_id])
  @@index([status])
  @@index([started_at])
}

model integration_webhooks {
  id           Int       @id @default(autoincrement())
  webhook_code String    @unique @db.VarChar(50)
  provider     String    @db.VarChar(50)
  event_type   String    @db.VarChar(100)
  payload_json String
  signature    String?   @db.VarChar(255)
  is_verified  Boolean   @default(false)
  processed    Boolean   @default(false)
  error_log    String?
  received_at  DateTime  @default(now()) @db.Timestamp(6)
  processed_at DateTime? @db.Timestamp(6)

  @@index([provider])
  @@index([event_type])
  @@index([processed])
}

model system_health_snapshots {
  id                   Int      @id @default(autoincrement())
  cpu_load_percent     Float
  memory_rss_mb        Float
  memory_heap_used_mb  Float
  memory_heap_total_mb Float
  db_pool_active       Int      @default(0)
  db_pool_idle         Int      @default(0)
  db_latency_ms        Float    @default(0)
  system_status        String   @default("HEALTHY") @db.VarChar(30)
  metadata             String?  @db.LongText
  created_at           DateTime @default(now()) @db.Timestamp(6)

  @@index([created_at])
  @@index([system_status])
}

model ai_automation_tasks {
  id            Int      @id @default(autoincrement())
  task_code     String   @unique @db.VarChar(50)
  task_type     String   @db.VarChar(50)
  input_payload String   @db.LongText
  output_result String   @db.LongText
  tokens_used   Int      @default(0)
  latency_ms    Int      @default(0)
  status        String   @default("COMPLETED") @db.VarChar(30)
  error_message String?
  created_by    Int?
  created_at    DateTime @default(now()) @db.Timestamp(6)

  @@index([task_type])
  @@index([created_at])
  @@index([status])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model lead_answers {
  id         Int
  lead_id    Int
  question   String    @db.Text
  answer     String?   @db.Text
  field_name String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)

  @@ignore
}

model task_assign {
  ta_id              Int       @id @default(autoincrement())
  task_id            Int
  assign_to          Int
  assign_by          Int
  task_status        Int       @default(0)
  actual_task_status Int       @default(1)
  assign_date        String    @db.VarChar(100)
  due_date           DateTime? @db.Date

  @@index([assign_to], map: "idx_task_assign_assign_to")
  @@index([task_id], map: "idx_task_assign_task")
}

model task_comments {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  task_id    BigInt   @db.UnsignedBigInt
  comment    String   @db.Text
  status     Int
  username   String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  @@index([task_id], map: "idx_task_id")
}

model task_notes {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  task_id    BigInt   @db.UnsignedBigInt
  sent_by    BigInt   @db.UnsignedBigInt
  sent_to    BigInt   @db.UnsignedBigInt
  note       String   @db.Text
  is_read    Boolean? @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  @@index([is_read], map: "idx_is_read")
  @@index([sent_to], map: "idx_sent_to")
  @@index([task_id], map: "idx_task_id")
}

model task_update_notes {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  task_id    BigInt    @db.UnsignedBigInt
  note       String    @db.Text
  created_by BigInt    @db.UnsignedBigInt
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)

  @@index([created_by], map: "idx_created_by")
  @@index([task_id], map: "idx_task_id")
}

model udyomi_kisan_categories {
  category_id   Int      @id @default(autoincrement())
  company_id    String   @db.VarChar(11)
  category_name String   @db.VarChar(100)
  added_by      Int
  date          DateTime @default(now()) @db.Timestamp(0)
}

model udyomi_kisan_services {
  service_id         Int      @id @default(autoincrement())
  company_id         String   @db.VarChar(11)
  category_id        Int
  service_name       String   @db.VarChar(100)
  service_price      Int
  partner_percentage Int      @default(0)
  description        String   @db.VarChar(2000)
  added_by           Int
  date               DateTime @default(now()) @db.Timestamp(0)

  @@index([service_id], map: "idx_udyami_services_id")
  @@index([service_id], map: "idx_udyomi_services_id")
}
